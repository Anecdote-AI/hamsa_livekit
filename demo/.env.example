# LiveKit (from https://cloud.livekit.io or your own server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Hamsa (https://tryhamsa.com)
HAMSA_API_KEY=

# LLM used by the demo agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Named worker => explicit dispatch only, so this demo cannot pick up jobs
# automatically dispatched on a shared project. serve.py dispatches it for you.
AGENT_NAME=hamsa-demo-local

# Voice. Any of the 113 names in livekithamsa/voices.py, or a cloned voice UUID.
HAMSA_SPEAKER=Amjad
HAMSA_DIALECT=pls
HAMSA_LANGUAGE=ar

# Transport per component. The socket is faster per request but does not return
# the [THINKING] end-of-speech signal, so putting STT on it disables EOS turn
# detection and falls back to VAD.
STT_TRANSPORT=http
TTS_TRANSPORT=websocket

# "hamsa" = EOS turn detection + chunked TTS
# "vad"   = VAD turn detection + the same chunked TTS (for benchmarking)
# "baseline" = stock VAD turn detection + one TTS request per reply
MODE=hamsa

# VAD silence threshold. Defaults to 0.2s under EOS, 0.55s without it.
# VAD_SILENCE=0.2

# The page can override all of the above per session; these are the fallbacks.
